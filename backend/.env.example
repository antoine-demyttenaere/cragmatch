# Database parts, used locally and in CI.
CRAGMATCH_POSTGRES_USER=""
CRAGMATCH_POSTGRES_PASSWORD=""
CRAGMATCH_POSTGRES_DB=""
CRAGMATCH_POSTGRES_HOST=""
CRAGMATCH_POSTGRES_PORT=""

# One URL instead of the five parts, for deployments. It wins over the parts
# (and the tests follow it too). Example: postgres://user:password@host:5432/db?sslmode=require
CRAGMATCH_POSTGRES_URL=""

# AI keys.
CRAGMATCH_ANTHROPIC_API_KEY=""
CRAGMATCH_VOYAGE_API_KEY=""

# Allowed browser origins, comma-separated. Blank means http://localhost:5173.
CRAGMATCH_CORS_ORIGINS=""

# Read only by the db container (the only unprefixed lines allowed here).
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""

# Container settings. Never uncomment them in this file (an unprefixed line
# that is not a field stops the app); set them on the container instead.
# PORT: port the API listens on (default 8000)
# FORWARDED_ALLOW_IPS: proxies whose client address headers are trusted
# HF_HOME: where the Voyage tokenizer is downloaded (must be writable)
# PGSSLMODE: TLS mode for the database connection, e.g. require
